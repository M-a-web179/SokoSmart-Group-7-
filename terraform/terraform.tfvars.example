# Copy this to terraform.tfvars and change the values.
# terraform.tfvars is gitignored, so your IP and profile stay local.

aws_region  = "eu-west-1"
aws_profile = null # or "default", or whatever profile you set up with `aws configure`

project     = "sokosmart"
environment = "dev"
owner       = "group-7"

# Your public IP with /32. Find it with: curl https://checkip.amazonaws.com
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Leave open so the app can be tested from a browser
app_allowed_cidrs = ["0.0.0.0/0"]
app_port          = 5000

instance_type       = "t3.micro"
ssh_public_key_path = "~/.ssh/sokosmart_f3.pub"
root_volume_size    = 20

vpc_cidr            = "10.20.0.0/16"
public_subnet_count = 2

extra_tags = {
  Course = "devops-f3"
}
