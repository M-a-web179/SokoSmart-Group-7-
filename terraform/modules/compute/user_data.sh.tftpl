#!/bin/bash
# First boot only. Keep this small: real configuration is done by Ansible.
set -euo pipefail

hostnamectl set-hostname ${hostname}

# Ansible needs python3 on the target; Ubuntu ships it but make sure
apt-get update -y
apt-get install -y python3 python3-apt

echo "bootstrapped by terraform on $(date -u)" > /etc/motd.d/10-terraform 2>/dev/null || true
